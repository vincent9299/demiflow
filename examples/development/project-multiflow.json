{
  "schema": "demiforge-project-v3",
  "standard": "1.0.0-candidate.10",
  "tool_root": "../demiflow",
  "sources": {
    "project-rules": {
      "path": "AGENTS.md"
    },
    "business-contract": {
      "path": "PIPELINE_SPEC.md"
    }
  },
  "watch": [
    "orders"
  ],
  "readonly": [],
  "projects": {
    "orders": {
      "path": "orders",
      "verify": [
        {
          "id": "unit",
          "argv": [
            "python3",
            "-B",
            "-m",
            "unittest",
            "discover",
            "-s",
            "orders/tests",
            "-v"
          ],
          "env": {
            "PYTHONPATH": "{project}"
          },
          "timeout": 120
        }
      ],
      "operators": [
        "orders/operators"
      ],
      "notebooks": [],
      "flows": {
        "select": {
          "path": "orders/flows/select.py",
          "symbol": "run"
        },
        "evaluate": {
          "path": "orders/flows/evaluate.py",
          "symbol": "run"
        }
      },
      "prompts": [
        "orders/prompts"
      ]
    }
  }
}
