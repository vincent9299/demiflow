{
  "schema": "demiforge-project-v2",
  "standard": "1.0.0-candidate.9",
  "tool_root": "../demiflow",
  "sources": {
    "project-rules": {
      "path": "AGENTS.md"
    },
    "business-contract": {
      "path": "PIPELINE_SPEC.md"
    }
  },
  "watch": [
    "orders"
  ],
  "readonly": [],
  "pipelines": {
    "orders": {
      "path": "orders",
      "entry": {
        "path": "orders/recipe.py",
        "symbol": "select_orders"
      },
      "verify": [
        {
          "id": "unit",
          "argv": [
            "python3",
            "-B",
            "-m",
            "unittest",
            "discover",
            "-s",
            "orders/tests",
            "-v"
          ],
          "env": {
            "PYTHONPATH": "{project}"
          },
          "timeout": 120
        }
      ],
      "operators": [
        "orders/processing.py"
      ],
      "notebooks": []
    }
  }
}
