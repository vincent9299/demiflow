{
  "schema": "demiforge-project-v1",
  "standard": "1.0.0-candidate.6",
  "tool_root": "../demiflow",
  "sources": {
    "project-rules": {"path": "AGENTS.md"},
    "business-contract": {"path": "PIPELINE_SPEC.md"}
  },
  "watch": ["orders"],
  "readonly": [],
  "pipelines": {
    "orders": {
      "path": "orders",
      "entry": "orders_pipeline.py",
      "verify": [
        {
          "id": "unit",
          "argv": ["python3", "-B", "-m", "unittest", "discover", "-s", "orders/tests", "-v"],
          "env": {"PYTHONPATH": "{project}"},
          "timeout": 120
        }
      ]
    }
  }
}
