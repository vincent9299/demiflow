{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiflow.local/schemas/forge-request-v1.json",
  "title": "demiflow Forge Pipeline Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "source_text", "goal", "row_grain", "input", "output", "map", "side_effects", "budgets", "completion", "unresolved_questions"],
  "properties": {
    "schema_version": {"const": "demiflow_forge_request_v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$"},
    "version": {"type": "string", "minLength": 1},
    "source_text": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "row_grain": {"type": "string", "minLength": 1},
    "input": {
      "type": "object", "additionalProperties": false, "required": ["name", "schema"],
      "properties": {"name": {"type": "string"}, "schema": {"type": "object"}}
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["name", "mode", "schema"],
      "properties": {
        "name": {"type": "string"},
        "mode": {"enum": ["create", "append", "overwrite"]},
        "schema": {"type": "object"}
      }
    },
    "map": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "description", "config", "config_schema"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "config": {"type": "object"},
        "config_schema": {"type": "object"}
      }
    },
    "side_effects": {
      "type": "object", "additionalProperties": false,
      "required": ["model_calls", "network", "external_writes"],
      "properties": {
        "model_calls": {"const": false},
        "network": {"const": false},
        "external_writes": {"const": false}
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false, "required": ["max_rows", "test_timeout_seconds"],
      "properties": {
        "max_rows": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "test_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "completion": {"type": "string", "minLength": 1},
    "unresolved_questions": {"type": "array", "maxItems": 0}
  }
}
