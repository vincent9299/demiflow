{
  "format": "demiflow_forge_standard_v1",
  "id": "demiflow.forge.engineering",
  "version": "2.1.0",
  "rules": [
    {
      "id": "FE-01",
      "requirement": "Platform facts come from trusted current public code. Discovery does not grant execution permission.",
      "scope": "platform inspection",
      "verification": [
        "static",
        "behavior"
      ],
      "coverage": "stage1"
    },
    {
      "id": "FE-02",
      "requirement": "Use one explicit business entrypoint and native Dataset composition; ordinary functions and actors retain their native interfaces.",
      "scope": "business implementation",
      "verification": [
        "static",
        "review"
      ],
      "coverage": "static_stage2_local_sync_experiments_stage3"
    },
    {
      "id": "FE-03",
      "requirement": "Model requests use native prompt or agent nodes. Business callbacks must not hide model clients, schedulers or nested pipelines.",
      "scope": "model boundaries",
      "verification": [
        "static",
        "behavior",
        "review"
      ],
      "coverage": "model_execution_not_enabled"
    },
    {
      "id": "FE-04",
      "requirement": "Pin input identity and scope. Preserve the business denominator and distinguish rejection, empty results, technical failure and completion.",
      "scope": "business delivery",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_experiments_stage3_formal_delivery_pending"
    },
    {
      "id": "FE-05",
      "requirement": "Prompt and model configuration use native versioned formats. Review actual rendered inputs and independent review boundaries.",
      "scope": "model configuration",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "model_execution_not_enabled"
    },
    {
      "id": "FE-06",
      "requirement": "Declare finite resources, failure, cleanup, reuse and publication boundaries. Native budgets and journals are not replaced by business infrastructure.",
      "scope": "execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_experiments_stage3_formal_delivery_pending"
    },
    {
      "id": "FE-07",
      "requirement": "Acceptance binds the requirement, rules, code, prompts, configuration, platform and verification implementation. Changes require renewed evidence.",
      "scope": "verification lifecycle",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "experiment_identity_stage3_formal_lifecycle_pending_stage4"
    },
    {
      "id": "FL-01",
      "requirement": "\u5165\u53e3/helper \u5728 flows\uff0c\u5b9e\u9645\u4f9d\u8d56\u53ca\u521d\u59cb\u5316\u53ef\u89e3\u6790\uff1b\u6ca1\u6709\u9690\u542b\u73af\u5883\u8f93\u5165\u6216\u5171\u4eab\u53ef\u53d8\u72b6\u6001",
      "scope": "\u5165\u53e3\u4e0e\u6765\u6e90",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "FL-02",
      "requirement": "\u4e3b\u6570\u636e\u8282\u70b9\u89e3\u6790\u5230\u5df2\u7ed1\u5b9a\u5e73\u53f0 API\uff1bhelper \u5c55\u5f00\u540e\u4ecd\u5168\u90e8\u5408\u89c4",
      "scope": "\u5e73\u53f0\u8c03\u7528",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "FL-03",
      "requirement": "\u4f9d\u636e\u539f\u751f\u7b7e\u540d\u6821\u9a8c\u5fc5\u9700\u53c2\u6570\u3001\u540d\u79f0\u3001\u91cd\u590d\u7ed1\u5b9a\u548c\u53ef\u786e\u5b9a\u503c\u7ea6\u675f",
      "scope": "\u53c2\u6570\u7ed1\u5b9a",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "FL-04",
      "requirement": "\u6bcf\u6761 Dataset \u7684\u6765\u6e90\u3001\u591a\u8f93\u5165\u3001\u53bb\u5411\u548c\u7ec8\u7ed3\u52a8\u4f5c\u53ef\u8bc6\u522b",
      "scope": "\u5b8c\u6574\u63a5\u7ebf",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "FL-05",
      "requirement": "\u6bcf\u4e2a\u8868\u8f93\u5165\u7ed1\u5b9a\u5141\u8bb8\u4f4d\u7f6e\u4e0e\u56fa\u5b9a\u7248\u672c\uff0c\u5b9e\u9645\u5f15\u7528\u53ef\u8bfb\u4e14\u5143\u6570\u636e\u543b\u5408",
      "scope": "\u6570\u636e\u8eab\u4efd",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "FL-06",
      "requirement": "\u4f9d\u636e\u539f\u751f\u89c4\u5219\u4f20\u64ad\u5b57\u6bb5\u7684\u5b58\u5728\u6027\u3001null\u3001\u7c7b\u578b\u548c\u6765\u6e90\uff0c\u5e76\u6838\u5bf9\u7aef\u53e3\u517c\u5bb9",
      "scope": "\u5b57\u6bb5\u4e0e\u7ed3\u6784",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "FL-07",
      "requirement": "\u8bfb\u5199\u3001\u6a21\u578b\u548c\u7269\u5316\u6548\u679c\u660e\u786e\uff1b\u65e0\u975e\u5e73\u53f0\u8c03\u5ea6\u6216\u8fd0\u884c\u65f6\u6784\u56fe",
      "scope": "\u6548\u679c\u4e0e\u63a7\u5236",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "FL-08",
      "requirement": "\u63a5\u7ebf\u9075\u5b88\u539f\u751f\u540c\u6b65/\u6d41\u5f0f\u3001\u540e\u7aef\u53ca\u7269\u5316\u7ea6\u675f",
      "scope": "\u539f\u751f\u6267\u884c\u9650\u5236",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "FL-09",
      "requirement": "\u81ea\u6709\u76ee\u6807\u3001\u660e\u786e\u6a21\u5f0f/\u6761\u4ef6/\u56de\u6267\uff1b\u591a\u5199\u5165\u548c\u8bfb\u5199\u4ea4\u53e0\u5177\u6709\u539f\u751f\u652f\u6301\u7684\u987a\u5e8f\u4e0e\u7248\u672c\u8bed\u4e49",
      "scope": "\u8f93\u51fa\u63d0\u4ea4",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "FL-10",
      "requirement": "\u5206\u522b\u6838\u5bf9\u6e90\u7801/\u53c2\u6570/\u8d44\u6e90/\u5e73\u53f0/\u6807\u51c6\u8eab\u4efd\uff0c\u4ee5\u53ca\u68c0\u67e5\u5668\u81ea\u8eab\u7684\u6709\u9650\u9884\u7b97",
      "scope": "\u8eab\u4efd\u4e0e\u9884\u7b97",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "OP-01",
      "requirement": "\u5b9e\u9645\u5b9a\u4e49\u53ef\u5b9a\u4f4d\uff0c\u4f9d\u8d56\u95ed\u5305\u548c\u6784\u9020\u53c2\u6570\u53ef\u7ed1\u5b9a",
      "scope": "\u5b9e\u73b0\u5f52\u5c5e",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "OP-02",
      "requirement": "\u5f62\u53c2\u3001\u5b57\u6bb5\u7ed1\u5b9a\u3001\u56fa\u5b9a\u53c2\u6570\u4e0e sync/async/actor \u534f\u8bae\u4e00\u81f4",
      "scope": "\u8c03\u7528\u534f\u8bae",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "OP-03",
      "requirement": "\u8f93\u5165\u8f93\u51fa\u7ed3\u6784\u660e\u786e\uff0cnullable\u3001\u8fd4\u56de\u5b57\u6bb5\u548c\u57fa\u6570\u4e0e\u8282\u70b9\u5339\u914d",
      "scope": "\u7aef\u53e3\u58f0\u660e",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "OP-04",
      "requirement": "\u4e0d\u63a5\u6536/\u521b\u5efa/\u6267\u884c\u5d4c\u5957 Dataset\uff0c\u4e0d\u8d1f\u8d23\u8868\u7ea7\u8c03\u5ea6",
      "scope": "\u5355\u8282\u70b9\u804c\u8d23",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "OP-05",
      "requirement": "\u6a21\u578b\u3001\u7f51\u7edc\u3001\u8868\u5199\u5165\u3001\u670d\u52a1\u3001\u8fdb\u7a0b\u548c\u8c03\u5ea6\u4e0d\u85cf\u5728\u8ba1\u7b97\u8282\u70b9",
      "scope": "\u5916\u90e8\u6548\u679c",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "OP-06",
      "requirement": "\u89e3\u6790\u5b9e\u9645\u7b26\u53f7\u3001\u63a5\u6536\u8005\u548c\u8c03\u7528\u95ed\u5305\uff1b\u6bcf\u9879\u5916\u90e8\u80fd\u529b\u6709\u7ed1\u5b9a\u7248\u672c\u7684\u6548\u679c\u8fb9\u754c",
      "scope": "\u8c03\u7528\u6765\u6e90\u4e0e\u6548\u679c\u53ef\u5224\u5b9a",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "OP-07",
      "requirement": "\u65e0\u521d\u59cb\u5316\u8d44\u6e90\u526f\u4f5c\u7528\uff1b\u8282\u70b9\u534f\u8bae\u548c\u9884\u7b97\u914d\u7f6e\u5408\u6cd5\uff0c\u672a\u9a8c\u8bc1\u7684\u6267\u884c\u4fdd\u8bc1\u5355\u5217",
      "scope": "\u751f\u547d\u5468\u671f\u534f\u8bae\u4e0e\u8d44\u6e90\u914d\u7f6e",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "OP-08",
      "requirement": "\u963b\u65ad\u5df2\u77e5\u5f02\u5e38\u6291\u5236\u6a21\u5f0f\uff1b\u539f\u751f\u9519\u8bef\u7b56\u7565\u663e\u5f0f\u53ef\u89c1\uff1b\u4e0d\u9759\u6001\u8bc1\u660e\u4e1a\u52a1\u5931\u8d25\u8bed\u4e49",
      "scope": "\u9519\u8bef\u5904\u7406\u7ed3\u6784\u4e0e\u7b56\u7565",
      "verification": [
        "static"
      ],
      "coverage": "supported_source_subset_stage2_runtime_not_run"
    },
    {
      "id": "EX-01",
      "requirement": "Execution binds sealed source, effective parameters, fixed input references and platform/environment identity.",
      "scope": "local experiment execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_sync_create_v1_per_run_evidence"
    },
    {
      "id": "EX-02",
      "requirement": "Only explicitly covered native synchronous local semantics may run; unknown or unsupported execution paths block.",
      "scope": "local experiment execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_sync_create_v1_per_run_evidence"
    },
    {
      "id": "EX-03",
      "requirement": "Read fixed versions and create only declared, distinct workspace-owned targets; never overwrite inputs or follow latest.",
      "scope": "local experiment execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_sync_create_v1_per_run_evidence"
    },
    {
      "id": "EX-04",
      "requirement": "Match the actual native plan and validate consumed callable inputs and actual return values without coercion.",
      "scope": "local experiment execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_sync_create_v1_per_run_evidence"
    },
    {
      "id": "EX-05",
      "requirement": "Persist action intent and native write receipts; verify committed versions before registering outputs; uncertain commits stay unknown.",
      "scope": "local experiment execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_sync_create_v1_per_run_evidence"
    },
    {
      "id": "EX-06",
      "requirement": "Apply finite admission, process, data, disk and time budgets; cancel owned work and preserve submitted results.",
      "scope": "local experiment execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_sync_create_v1_per_run_evidence"
    },
    {
      "id": "EX-07",
      "requirement": "Track each independent action and preserve partial commits; whole-run success requires every expected action and output.",
      "scope": "local experiment execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_sync_create_v1_per_run_evidence"
    },
    {
      "id": "EX-08",
      "requirement": "Results are fixed DatasetRefs backed by native receipts; case comparison uses explicit keys and continuation pins the selected version.",
      "scope": "local experiment execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_sync_create_v1_per_run_evidence"
    },
    {
      "id": "EX-09",
      "requirement": "Start, cancel and reconciliation are idempotent control operations; a retry of the same run must not execute it twice.",
      "scope": "local experiment execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_sync_create_v1_per_run_evidence"
    },
    {
      "id": "EX-10",
      "requirement": "UI, CLI and Python share run facts; unknown progress, interrupted ownership and missing output versions are explicit.",
      "scope": "local experiment execution",
      "verification": [
        "behavior",
        "review"
      ],
      "coverage": "local_sync_create_v1_per_run_evidence"
    }
  ]
}
