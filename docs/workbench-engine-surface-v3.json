    "control.RunContext": {
      "members": [
        "attach",
        "__enter__",
        "__exit__",
        "validate_recovery_identity"
      ],
      "returned": "Existing context manager establishment only; validate_recovery_identity accepts an original identity document, purely validates supported format/protocol without I/O, state change or platform comparison, and raises original RecoveryContractError; worker does not bind returned RunContext or access its state. CheckedExecution.bind_context() independently uses original ContextVar mechanism; no new coupling."
    },
    "control.RunJournal": {
      "conditional": "connection_scope is process-local bounded connection reuse; transactions and attempt fencing remain per operation. reserve_nodes/reserve_actions only initial prepare; resumed managed attempts must pass both to begin_attempt. Remove listed read members that final facts migration leaves unused; never expand to arbitrary class members.",
      "constructor": "directory, attempt=None; existing approved public options only, no _maintenance_deadline from host",
      "forbidden": [
        "db",
        "_connection",
        "_transaction",
        "_reserve_capacity",
        "claim_execution",
