    "demiflow.workbench.runs.view._reading": "tuple:unknown,RunReader"
  },
  "return_contracts": {
    "RunReader.execution_view": {
      "result": {
        "actions": "dict[action_id, dict[kind,JsonValue]], full compatibility diagnostics assembled natively",
        "completion": "JsonValue|None, only full",
        "current_attempt": "int|None",
        "events": "list[{sequence:int, action_id:str, kind:str, value:JsonValue}], selected attempt diagnostics only",
        "manifest": "JsonObject|None, original bounded manifest",
        "observations": "list[JsonObject], original full only",
        "output_projections": "dict[action_id, OutputProjection] for requested manifest output action IDs; absent for identity detail",
        "revision": "int, current control revision",
        "state": "JsonObject|None, selected attempt original state"
      },
      "signature": "execution_view(*, detail='full', action_ids=None, attempt=None) -> ExecutionView"
    },
    "RunReader.list_attempts": {
      "result": "Original attempt state documents ordered by attempt, at most32; known legacy no-attempt behavior retained. Each document keeps original values; current RunJournal.list_attempts64 KiB encoded limit remains.",
      "signature": "list_attempts() -> list[JsonObject]"
    },
    "RunReader.native_maintenance_state": {
      "result": {
        "gc_settled": "bool",
        "owner_released": "bool"
      },
      "signature": "native_maintenance_state() -> NativeMaintenanceState"
    },
    "RunReader.output_projection": {
      "related_types": {
        "Evidence": {
          "attempt": "int effective evidence attempt",
          "checkpoint_node": "str|None, legacy checkpoint only",
          "kind": "one existing event kind: receipt/recovered/stage_commit/stage_recovered",
          "row_count": "int>=0|None, receipt only",
          "schema_hash": "str|None, receipt only",
          "schema_identity": "str|None, stage only",
          "uri": "str",
          "version": "int>=1"
        }
      },
      "result": {
        "action_id": "str",
        "action_sequence": "int selected event revision",
        "attempt": "int selected",
        "commit": "optional JsonObject|None when diagnostics=True, old full location/value",
        "committed": "bool, journal-recorded receipt/stage commit only",
        "current_attempt": "int|None",
        "error": "JsonValue|None, exact selected-attempt failed value",
        "evidence": "Evidence|None",
        "failed": "bool selected attempt has failed fact",
        "has_intent": "bool selected attempt has an intent",
        "receipt": "optional JsonObject|None when diagnostics=True, old full location/value",
        "result": "{ref:DatasetRef-wire, location_id:str}|None",
        "result_ref": "DatasetRef-wire|None, same result.ref convenience for compact",
        "retained_from_attempt": "int|None",
        "revision": "int current control revision"
      },
      "signature": "output_projection(selected_attempt, action_id, *, diagnostics=False) -> OutputProjection"
    },
    "RunReader.preparation_evidence": {
      "result": {
        "prepare_request_id": "str|None",
        "root": "str|None",
        "run_id": "str|None",
        "status": "existing design values never_started or not_proven"
      },
      "signature": "preparation_evidence() -> PreparationEvidence"
    },
    "action_recovery_facts": {
      "result": {
        "absence_eligible": "bool",
        "absence_recorded": "bool",
        "action_id": "str",
        "attempt": "int|None selected",
        "current_attempt": "int|None",
        "native_action_present": "bool",
        "native_completed": "bool",
        "recovery_restricted": "bool",
        "revision": "int"
      },
      "signature": "action_recovery_facts(directory, action_id, *, attempt=None, deadline=None) -> ActionRecoveryFacts"
    },
    "observe_storage": {
      "related_types": {
        "NativeFootprint": {
          "native_run_id": "str|None original identity",
          "object_roots": "tuple[{root_id:str,logical_root:str,physical_root:str,run_id:str},...] original bounded registration records",
          "relative_roots": "tuple[str,...], exactly current native state/materializations/scratch paths relative to owned run root"
        },
        "StorageSnapshot": {
          "identity": "{run_id:JsonValue}|None",
          "identity_digest": "str|None original complete identity hash",
          "manifest": "{run_id:JsonValue,object_locations:JsonValue,report_digest:JsonValue}|None",
          "manifest_digest": "str|None original complete manifest hash",
          "object_roots": "list[{root_id:str,logical_root:str,physical_root:str,run_id:str}]|None",
          "state": "{status:JsonValue,attempt:JsonValue}|None, existing projection"
        }
      },
      "result": {
        "change_token": "opaque equality-comparable str digest or tuple; only equality allowed",
        "exists": "bool original journal presence; observation fixed at entry",
        "native_footprint()": "NativeFootprint",
        "snapshot()": "original six-key StorageSnapshot"
      },
      "signature": "observe_storage(directory=None, *, directory_fd=None, deadline=None) -> contextmanager[StorageObservation]"
    },
    "read_action_plan": {
      "result": {
        "action_id": "str original",
        "artifact_manifest_ref": "JsonObject|None original accepted reference, diagnostics when not consumed",
        "code_pin_ref": "JsonObject|None v3 view original if present",
        "dag_id": "str original",
        "engine_run_id": "str|None original recovery run identity",
        "identity_bridge_ref": "JsonObject|None original validated carrier ref if present",
        "plan_id": "str original",
        "plan_view": "JsonObject normalized dag/node_map/physical/node_observations view",
        "recovery_restriction": "JsonObject|None original bounded public history restriction",
        "sealed_at": "original JSON scalar accepted by old reader; do not newly tighten F1",
        "version": "existing v3 or explicit F1 version tag; F1 tag is new internal envelope only, old host response need not gain it"
      },
      "signature": "read_action_plan(directory, action_id, *, max_bytes, deadline=None) -> ActionPlan|None"
    },
    "read_verified_identity_bridge": {
      "result": {
        "bridge": "existing demiflow.identity_bridge.v1 JsonObject with verified bounded entries; original accepted extra fields preserved",
        "ref": "original validated carrier reference {sha256:str,path:str,bytes:int}"
      },
      "signature": "read_verified_identity_bridge(directory, action_id, *, expected_dag_id, expected_report_digest, max_bytes, deadline=None) -> VerifiedBridge|None"
    },
    "verify_published_output": {
      "result": {
        "action_id": "str",
        "action_sequence": "int selected attempt event revision",
        "attempt": "int effective fact attempt",
        "checkpoint_node": "str|None; legacy checkpoint requires exact expected node",
        "current_attempt": "int|None",
        "recording": "Recording|None",
        "reference": "{uri:str,version:int>=1}",
        "result_kind": "existing product event kind result or recovered_result; write receipts retain result, recovered stages use recovered_result",
        "retained_from_attempt": "int|None",
        "revision": "int current control revision",
        "row_count": "int>=0",
        "schema_hash": "str nonempty",
        "schema_identity": "str|None; stage requires exact expected schema identity",
        "uri": "str exact expected URI",
        "version": "int>=1 fixed version"
      },
      "signature": "verify_published_output(directory, action_id, *, expected_uri, expected_schema_identity, publication=None, expected_checkpoint_node=None, report_digest=None, parents=None, attempt=None, recover=False, require_current_head=False, deadline=None) -> VerifiedPublication|None"
    },
    "verify_write_receipt": {
      "related_types": {
        "Recording": {
          "action_id": "str same returned action_id",
          "attempt": "int exact target selected attempt, may differ from effective retained evidence only when newly recovering into selected attempt",
          "kind": "existing action event kind recovered or stage_recovered only",
          "value": "opaque JsonObject <=256 KiB encoded, assembled and validated by native owner"
        }
      },
      "result": {
        "action_id": "str",
        "action_sequence": "int selected attempt event revision",
        "attempt": "int effective fact attempt",
        "checkpoint_node": "str|None; legacy checkpoint requires exact expected node",
        "current_attempt": "int|None",
        "recording": "Recording|None",
        "reference": "{uri:str,version:int>=1}",
        "result_kind": "existing product event kind result or recovered_result; write receipts retain result, recovered stages use recovered_result",
        "retained_from_attempt": "int|None",
        "revision": "int current control revision",
        "row_count": "int>=0",
        "schema_hash": "str nonempty",
        "schema_identity": "str|None; stage requires exact expected schema identity",
        "uri": "str exact expected URI",
        "version": "int>=1 fixed version"
      },
      "signature": "verify_write_receipt(directory, action_id, *, expected_uri, attempt=None, recover=False, require_current_head=False, deadline=None) -> VerifiedPublication|None"
    }
  }
}
