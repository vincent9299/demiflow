-.sidebar-heading{font-size:12px;font-weight:500;color:var(--muted);margin:0 12px 10px}
-.project-list{display:flex;flex-direction:column;gap:4px;flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;padding:4px;margin:0 -4px 16px}
-.project-list .project-item{display:flex;align-items:center;gap:8px;flex-shrink:0;min-width:0;width:100%;padding:10px 12px;text-align:left;font-size:13px;border-color:transparent;background:transparent;color:#586579}
-.project-list .project-item:hover{background:#eef0f5}.project-list .project-item.active{background:#e9eefb;color:#3154ae;font-weight:600}
-.project-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.project-unavailable{flex-shrink:0;font-size:10px;font-weight:400;color:var(--muted)}.project-empty{font-size:12px;color:var(--muted);margin:0 12px}
