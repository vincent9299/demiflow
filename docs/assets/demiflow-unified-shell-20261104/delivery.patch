 :root{font:15px/1.65 system-ui,-apple-system,"Segoe UI",sans-serif;color:#26313f;background:#fff;--accent:#3b63cf;--brand:#225e61;--line:#e4e7ed;--muted:#697386;--danger:#a33b36;scroll-padding-top:96px}
 *{box-sizing:border-box}[hidden]{display:none!important}body{margin:0}button,input,select,textarea{font:inherit;max-width:100%}button{cursor:pointer;background:#fff;border:1px solid #dce1e9;border-radius:8px;padding:7px 12px;color:#33435b}button:hover{background:#f3f5fa;border-color:#aebbd4}button.active{background:#edf1fc;color:#294faa;border-color:#b5c5ed}button:disabled{opacity:.5;cursor:default}button.primary{background:var(--accent);border-color:var(--accent);color:white}button.primary:hover{background:#3055b8}button.quiet{background:transparent;border-color:transparent;color:var(--muted);font-size:12px}input,select,textarea{border:1px solid #dce1e9;border-radius:7px;background:#fff;padding:7px 9px;min-width:0}input.wide{width:360px}:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
-.shell{display:grid;grid-template-columns:248px minmax(0,1fr);min-height:100vh}
-.sidebar{position:sticky;top:0;height:100dvh;min-width:0;overflow:hidden;display:flex;flex-direction:column;padding:28px 16px 20px;background:#f8f9fb;border-right:1px solid var(--line)}
